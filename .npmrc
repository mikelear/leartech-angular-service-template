@mikelear:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GIT_TOKEN}
# Supply-chain hardening (semgrep npm-missing-minimum-release-age): npm will not
# install a version published less than 7 days ago, so a freshly-published
# malicious release ages out before it can be pulled.
min-release-age = 7
